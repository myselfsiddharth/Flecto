# Both spellings: a bare `node_modules/` matches directories only, so a symlink
# by that name (a worktree pointed at a shared install) slips past `git add -A`.
node_modules/
node_modules
demo/
.flecto-snapshots/
.flecto-queue/
.flecto-tmp/
.DS_Store
*.log
npm-debug.log*

# Coverage data, regenerated by `npm run coverage`.
coverage.lcov

# Minimized fuzz inputs, written by `npm run fuzz`. A finding worth keeping is
# moved into test/fixtures/fuzz/, where the normal suite replays it.
test/fuzz/findings/

.claude/
